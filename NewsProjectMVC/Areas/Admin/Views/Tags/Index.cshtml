@model IEnumerable<NewsProjectMVC.Models.Db.Tag>

@{
    ViewData["Title"] = "Tags";
}


<p>
    <a href="/Admin/Tags/Create" class="btn btn-outline-primary">Add New Tag</a>

</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" data-bs-toggle="tooltip" title="Edit" class="btn btn-link btn-primary btn-lg">
                        <i class="fas fa-edit"></i>
                    </a>
                    |
                    <a asp-action="Delete" asp-route-id="@item.Id" data-bs-toggle="tooltip" title="Delete" class="btn btn-link btn-danger btn-lg">
                        <i class="fas fa-times-circle"></i>
                    </a>
            </td>
        </tr>
}
    </tbody>
</table>
