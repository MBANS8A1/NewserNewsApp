@model IEnumerable<NewsProjectMVC.Models.Db.Subscriber>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SubscribedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.SubscribedAt)
            </td>
            <td>
                @Html.DisplayFor(model => item.IsActive)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" data-bs-toggle="tooltip" title="Edit" class="btn btn-link btn-primary btn-lg">
                        <i class="fas fa-edit"></i>
                    </a>
                    |
                    <a asp-action="Delete" asp-route-id="@item.Id" data-bs-toggle="tooltip" title="Delete" class="btn btn-link btn-danger btn-lg">
                        <i class="fas fa-times-circle"></i>
                    </a>
            </td>
        </tr>
}
    </tbody>
</table>
