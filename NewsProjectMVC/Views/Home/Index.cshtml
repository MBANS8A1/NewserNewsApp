@model NewsProjectMVC.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home Page";
}

        <!-- Features Start -->
        <div class="container-fluid features mb-5">
            <div class="container py-5">
                <div class="row g-4">
                  @foreach (var newsItem in Model.FeaturedNews)
                  {
                <div class="col-md-6 col-lg-6 col-xl-3">
                    <div class="row g-4 align-items-center features-item">
                        <div class="col-4">
                            <div class="rounded-circle position-relative">
                                <div class="overflow-hidden rounded-circle">
                                    <img src="/images/news/thumb_@newsItem.ImageName" class="img-zoomin img-fluid rounded-circle w-100" alt="@newsItem.Title">
                                </div>
                                <span class="rounded-circle border border-2 border-white bg-primary btn-sm-square text-white position-absolute" style="top: 10%; right: -10px;">@newsItem.ViewCount</span>
                            </div>
                        </div>
                        <div class="col-8">
                            <div class="features-content d-flex flex-column">
                                <a href="/news/@newsItem.Id" class="h6">
                                    @newsItem.Title
                                </a>
                                <small class="text-body d-block"><i class="fas fa-calendar-alt me-1"></i>@newsItem.CreatedAt.ToString("MMMM dd, yyyy")</small>
                            </div>
                        </div>
                    </div>
                </div>

                  }
                    
                </div>
            </div>
        </div>
        <!-- Features End -->
        <!-- Main Post Section Start -->
        <div class="container-fluid py-5">
            <div class="container py-5">
                <div class="row g-4">
                    <div class="col-lg-7 col-xl-8 mt-0">
                        @if (Model.MainNews != null)
                        {
                      <div class="position-relative overflow-hidden rounded">
                          <img src="/images/news/@Model.MainNews.ImageName" class="img-fluid rounded img-zoomin w-100" alt="Main News Image"/>
                          <div class="d-flex justify-content-center px-4 position-absolute flex-wrap" style="bottom: 10px; left: 0;">
                              <a href="#" class="text-white me-3 link-hover"><i class="fa fa-clock"></i>@NewsProjectMVC.Models.Helpers.TextHelpers.CalculateReadingTime(Model.MainNews.LongDescription) minute(s) read</a>
                              <a href="#" class="text-white me-3 link-hover"><i class="fa fa-eye"></i>@Model.MainNews.ViewCount View(s)</a>                      
                          </div>
                      </div>
                      <div class="border-bottom py-3">
                          <a href="/news/@Model.MainNews.Id" class="display-4 text-dark mb-0 link-hover">@Model.MainNews.Title</a>
                      </div>
                      <p class="mt-3 mb-4">
                          @Model.MainNews.ShortDescription
                      </p>
                        }
                      @if (Model.TopStory != null)
                      {
                    <div class="bg-light p-4 rounded">
                        <div class="news-2">
                            <h3 class="mb-4">Top Story</h3>
                        </div>
                        <div class="row g-4 align-items-center">
                            <div class="col-md-6">
                                <div class="rounded overflow-hidden">
                                    <img src="/images/news/@Model.TopStory.ImageName" class="img-fluid rounded img-zoomin w-100" alt="Top News Image">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex flex-column">
                                    <a href="/news/@Model.TopStory.Id" class="h3">@Model.TopStory.Title</a>
                                    <p class="mb-0 fs-5"><i class="fa fa-clock"> @NewsProjectMVC.Models.Helpers.TextHelpers.CalculateReadingTime(Model.TopStory.LongDescription) minute(s) read</i> </p>
                                    <p class="mb-0 fs-5"><i class="fa fa-eye">@Model.TopStory.ViewCount Views</i></p>
                                </div>
                            </div>
                        </div>
                    </div>
                      }                  
                    </div>
                    <div class="col-lg-5 col-xl-4">
                       <div class="bg-light rounded p-4 pt-0">
                            <div class="row g-4">
                           @foreach (var newsItem in Model.BestNews)
                           {
                            <div class="col-12">
                                <div class="row g-4 align-items-center">
                                    <div class="col-5">
                                        <div class="overflow-hidden rounded">
                                            <img src="/images/news/thumb_@newsItem.ImageName" class="img-zoomin img-fluid rounded w-100" alt="@newsItem.Title">
                                        </div>
                                    </div>
                                    <div class="col-7">
                                        <div class="features-content d-flex flex-column">
                                            <a href="/news/@newsItem.Id" class="h6">@newsItem.Title</a>
                                            <small><i class="fa fa-clock">@NewsProjectMVC.Models.Helpers.TextHelpers.CalculateReadingTime(newsItem.LongDescription) minute(s) read</i> </small>
                                            <small><i class="fa fa-eye">@newsItem.ViewCount View(s)</i></small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                           }                                                        
                            </div>
                       </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Main Post Section End -->
