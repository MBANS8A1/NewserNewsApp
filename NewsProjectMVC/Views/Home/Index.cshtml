        <!-- Most Popular News Start -->
        <div class="container-fluid populer-news py-5">
            <div class="container py-5">
                <div class="tab-class mb-4">
                    <div class="row g-4">
                        <div class="col-12">
                            <div class="d-flex flex-column flex-md-row justify-content-md-between border-bottom mb-4">
                                <h1 class="mb-4">What’s New</h1>
                                <ul class="nav nav-pills d-inline-flex text-center">
                                 @foreach (var item in Model.MainPageCategories)
                                 {
                                <li class="nav-item mb-3">
                                    <a class="d-flex py-2 bg-light rounded-pill @(item == Model.MainPageCategories.First() ? "active" : "") me-2" data-bs-toggle="pill" href="#tab-@item.Category?.Id">
                                        <span class="text-dark" style="width: 100px;">@item.Category?.Title</span>
                                    </a>
                                </li>
                                 }
                                    
                                </ul>
                            </div>
                            <div class="tab-content mb-4">
                              @foreach (var item in Model.MainPageCategories)
                              {
                                <div id="tab-@item.Category?.Id" class="tab-pane fade show p-0 @(item == Model.MainPageCategories.First() ? "active" : "")">
                                @{
                                    var lastNews = item.News.FirstOrDefault();
                                    var remainingNews = item.News.Skip(1);
                                }
                                <div class="row g-4">
                                    @if (lastNews !=  null)
                                    {
                                        <div class="col-lg-8">
                                            <div class="position-relative rounded overflow-hidden">
                                                <img src="/images/news/@lastNews.ImageName" class="img-zoomin img-fluid rounded w-100" alt="@lastNews.Title">
                                                <div class="position-absolute text-white px-4 py-2 bg-primary rounded" style="top: 20px; right: 20px;">
                                                   @item.Category?.Title
                                                </div>
                                            </div>
                                            <div class="my-4">
                                                <a href="/news/@lastNews.Id" class="h4">@lastNews.Title</a>
                                            </div>
                                            <div class="d-flex justify-content-between">
                                                <a href="#" class="text-dark link-hover me-3"><i class="fa fa-clock"></i> @NewsProjectMVC.Models.Helpers.TextHelpers.CalculateReadingTime(@lastNews.LongDescription) minute(s) read</a>
                                                <a href="#" class="text-dark link-hover me-3"><i class="fa fa-eye"></i> @lastNews.ViewCount View(s)</a>
                                               
                                            </div>
                                            <p class="my-4">
                                                @lastNews.ShortDescription
                                            </p>
                                        </div>
                                        <div class="col-lg-4">
                                            <div class="row g-4">
                                                @foreach (var newsItem in remainingNews)
                                                {
                                                    <div class="col-12">
                                                        <div class="row g-4 align-items-center">
                                                            <div class="col-5">
                                                                <div class="overflow-hidden rounded">
                                                                    <img src="/images/news/thumb_@newsItem.ImageName" class="img-zoomin img-fluid rounded w-100" alt="@newsItem.Title">
                                                                </div>
                                                            </div>
                                                            <div class="col-7">
                                                                <div class="features-content d-flex flex-column">
                                                                    <p class="text-uppercase mb-2">@item.Category?.Title</p>
                                                                    <a href="/news/@newsItem.Id" class="h6">@newsItem.Title</a>
                                                                    <small class="text-body d-block"><i class="fas fa-calendar-alt me-1"></i>@newsItem.CreatedAt.ToString("MMM dd, yyyy")</small>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-12">
                                            <p>No news found for this category!</p>
                                        </div>
                                    }

                                </div>
                            </div>

                              }
                            </div>
                            <div class="border-bottom mb-4">
                                <h2 class="my-4">Most Views News</h2>
                            </div>
