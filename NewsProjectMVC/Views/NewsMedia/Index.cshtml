@model IEnumerable<NewsProjectMVC.Models.Db.News>

@{
    ViewData["Title"] = "News Search";
}

<div class="container mt-5">

    <div class="card shadow-sm mb-5">
        <div class="card-body">
            <h5 class="card-title">Filter News</h5>
            <form method="get" class="mt-3">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label for="searchTerm" class="form-label">Title</label>
                        <input type="text" id="searchTerm" name="searchTerm" class="form-control" placeholder="Search by title..." value="@ViewBag.CurrentSearchTerm">
                    </div>
                    <div class="col-md-3">
                        <label for="categoryId" class="form-label">Category</label>
                        <select id="categoryId" name="categoryId" class="form-select" asp-items="@ViewBag.Categories">
                            <option value="">All Categories</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="tag" class="form-label">Tag</label>
                        <input type="text" id="tag" name="tag" class="form-control" placeholder="Search by tag..." value="@ViewBag.CurrentTag">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Search</button>
                    </div>
                </div>
            </form>
        </div>
    </div>


    <div class="row g-4">
        <div class="col-lg-3 col-md-6 col-12 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="/images/news/thumb_news1.jpg" class="card-img-top" alt="Breaking News: Technology Advances" style="height: 200px; object-fit: cover;">

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Breaking News: Technology Advances</h5>
                    <p class="card-text text-body-secondary">Latest developments in artificial intelligence are changing the world as we know it.</p>

                    <a href="/news/1" class="btn btn-outline-primary mt-auto">Read More</a>
                </div>
                <div class="card-footer text-body-secondary">
                    <small>Jan 15, 2024</small>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 col-12 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="/images/news/thumb_news2.jpg" class="card-img-top" alt="Sports Update: Championship Finals" style="height: 200px; object-fit: cover;">

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Sports Update: Championship Finals</h5>
                    <p class="card-text text-muted">The most anticipated match of the season is finally here with exciting moments.</p>

                    <a href="/news/2" class="btn btn-outline-primary mt-auto">Read More</a>
                </div>
                <div class="card-footer text-muted">
                    <small>May 20, 2026</small>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 col-12 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="/images/news/thumb_news3.jpg" class="card-img-top" alt="Economic Growth Report 2024" style="height: 200px; object-fit: cover;">

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Economic Growth Report 2026</h5>
                    <p class="card-text text-muted">Markets show positive trends with significant growth in various sectors worldwide.</p>

                    <a href="/news/3" class="btn btn-outline-primary mt-auto">Read More</a>
                </div>
                <div class="card-footer text-muted">
                    <small>Jun 10, 2026</small>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 col-12 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="/images/news/thumb_news4.jpg" class="card-img-top" alt="Health & Wellness Tips" style="height: 200px; object-fit: cover;">

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Health & Wellness Tips</h5>
                    <p class="card-text text-muted">Expert advice on maintaining a healthy lifestyle in the modern busy world.</p>

                    <a href="/news/4" class="btn btn-outline-primary mt-auto">Read More</a>
                </div>
                <div class="card-footer text-muted">
                    <small>Aug 05, 2026</small>
                </div>
            </div>
        </div>
    </div>

</div>
