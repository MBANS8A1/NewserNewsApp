@{
    ViewData["Title"] = "Access Denied";
}
<div class="container py-1 px-1 mx-auto my-auto w-80 h-30 rounded" style="background-color:#D9DDDC;">
        <div class="row mb-1 me-1">
        <div class="col-12"><h2 style="text-align:center;">Access Denied (Http @ViewData["permissionRespCode"] Error)</h2></div>
        </div>
        <div class="row mb-1 me-0.5">
            <div class="col-sm-9 col-md-6 text-center"><p class="fw-bold text-dark">You do not have permission to access this resource!</p></div>
            <div class="col-sm-3 col-md-6 d-flex justify-content-center align-items-center"><img class="img-fluid" style="max-width:60px; max-height:60px" src="/images/access_denied_icon.jpg" alt="Access-Denied-Icon" /></div>
        </div>
        <div class="row me-0.5">
            <div class="col-4 d-flex justify-content-center">
                <a href="javascript:history.back()" class="btn btn-outline-dark">Go Back</a>    
            </div>
           
            <div class="col-4 d-flex justify-content-center">
                <a asp-controller="News" asp-area="Admin" asp-action="Index" class="btn btn-outline-dark">To News Admin Section</a>
            </div>

            <div class="col-4 d-flex justify-content-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">To Homepage</a>
            
            </div>
                
        </div>
</div>
